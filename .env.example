# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
STORE_NAME=Bento Lab
STORE_ADDRESS=12 Sample Lane, Sydney NSW 2000
STORE_TIMEZONE=Australia/Sydney
STORE_CURRENCY=AUD
# Local demo only. Production startup rejects DEMO_MODE=true.
DEMO_MODE=true

# Database (Neon PostgreSQL, Sydney). Leave blank for the in-memory demo.
DATABASE_URL=

# Staff access
AUTH_SECRET=replace-with-a-long-random-string
STAFF_EMAILS=owner@example.com,manager@example.com

# Square (single merchant)
SQUARE_ENV=sandbox
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_APPLICATION_ID=
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_API_VERSION=2026-09-16
SQUARE_CATEGORY_BOX_ID=
SQUARE_CATEGORY_PROTEIN_ID=
SQUARE_CATEGORY_VEGETABLE_ID=
SQUARE_CATEGORY_STARCH_ID=

# Email
RESEND_API_KEY=
EMAIL_FROM=Bento Lab <orders@example.com>

# Cron
CRON_SECRET=replace-with-a-random-string
